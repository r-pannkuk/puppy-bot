    "devDependencies": {
        "@sapphire/eslint-config": "^4.4.3",
        "@sapphire/fetch": "^2.4.2",
        "@sapphire/prettier-config": "^2.0.0",
        "@sapphire/ts-config": "^5.0.3",
        "@types/bull": "^3.15.9",
        "@types/node": "^22.19.11",
        "@vitest/coverage-v8": "^4.0.18",
        "jsonpath-object-transform": "^1.0.4",
        "npm-run-all": "^4.1.5",
        "prettier": "^3.5.3",
        "prisma": "^5.22.0",
        "tsx": "^4.21.0",
        "typescript": "^5.7.0",
        "vitest": "^4.0.18"
    },
    "scripts": {
        "build": "tsc -b src",
        "watch": "tsc -b src -w",
        "start": "node --enable-source-maps --max-old-space-size=2048 dist/index.js",
        "lavalink": "java -jar lavalink/Lavalink.jar --spring.config.location=lavalink/application.yml",
        "dev": "run-s build start",
        "format": "prettier --write \"src/**/*.ts\"",
        "test": "run-s test:python test:js",
        "test:python": "node -e \"require('child_process').execSync(process.platform==='win32'?'.venv\\\\Scripts\\\\python -m pytest tests/python/ -v':'.venv/bin/python -m pytest tests/python/ -v',{stdio:'inherit'})\"",
        "test:js": "vitest run",
        "test:unit": "vitest run tests/unit",
        "test:integration": "vitest run tests/integration",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "lint": "eslint src --ext .ts",
        "lint:fix": "eslint src --ext .ts --fix"
    },
    "prettier": "@sapphire/prettier-config"
}
