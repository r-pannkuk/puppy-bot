        "@redis/client": "^1.6.1",
        "@sapphire/decorators": "^6.2.0",
        "@sapphire/discord-utilities": "^3.5.0",
        "@sapphire/discord.js-utilities": "^7.3.3",
        "@sapphire/framework": "^4.8.5",
        "@sapphire/plugin-api": "^5.2.0",
        "@sapphire/plugin-editable-commands": "^3.1.0",
        "@sapphire/plugin-logger": "^3.0.7",
        "@sapphire/plugin-scheduled-tasks": "^7.1.2",
        "@sapphire/plugin-subcommands": "^4.3.0",
        "@sapphire/stopwatch": "^1.5.4",
        "@sapphire/time-utilities": "^1.7.14",
        "@sapphire/utilities": "^3.18.2",
        "@sentry/node": "^8.0.0",
        "@types/jsdom": "^21.1.7",
        "bull": "^4.16.5",
        "chrono-node": "^2.9.0",
        "discord-api-types": "^0.38.40",
        "discord.js": "^14.25.1",
        "dotenv": "^16.6.1",
        "formidable": "^3.5.4",
        "googleapis": "^171.4.0",
        "got": "^13.0.0",
        "jsdom": "^25.0.0",
        "moment-timezone": "^0.5.48",
        "pretty-ms": "^7.0.1",
        "python-shell": "^3.0.1",
        "reflect-metadata": "^0.2.2",
        "shoukaku": "^4.2.0",
        "zod": "^3.24.0"
