{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "target": "ES2022",
        "module": "CommonJS",
        "rootDir": ".",
        "outDir": "../dist",
        "moduleResolution": "node",
        "noImplicitAny": false,
        "noEmitOnError": true,
        "esModuleInterop": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "removeComments": false,
        "sourceMap": true,
        "allowJs": false,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "exclude": [
        "./tsconfig.json"
    ],
    "include": [
        "."
    ]
}