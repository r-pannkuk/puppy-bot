{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "lib": ["ESNext", "DOM"],
        "target": "ES2022",
        "module": "CommonJS",
        "moduleResolution": "node",
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "skipLibCheck": true,
        "noEmit": true
    },
    "include": [
        "src",
        "tests",
        "vitest.config.ts"
    ]
}